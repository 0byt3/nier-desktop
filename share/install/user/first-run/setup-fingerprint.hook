#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if nier-hw-fingerprint && [[ ! -f /etc/pam.d/nier-lock-fingerprint ]] &&
  nier-done ensure fingerprint-setup-invitation; then
  nier-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec nier-launch-floating-terminal-with-presentation nier-setup-security-fingerprint
fi
