#!/bin/bash

set -e

# Nier ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(nier-default-agent) ]] && nier-done ensure agent-setup-invitation; then
  nier-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Nier." \
    --exec nier menu summon setup.default.agent
fi
