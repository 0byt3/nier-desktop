{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "nier.clock",
    "layout": {
      "left": [
        {
          "id": "nier.menu"
        },
        {
          "id": "nier.workspaces"
        }
      ],
      "center": [
        {
          "id": "nier.indicators"
        },
        {
          "id": "nier.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "nier.keyboard-layout"
        },
        {
          "id": "nier.weather"
        },
        {
          "id": "nier.system-update"
        }
      ],
      "right": [
        {
          "id": "nier.tray"
        },
        {
          "id": "nier.agents"
        },
        {
          "id": "nier.bluetooth"
        },
        {
          "id": "nier.network"
        },
        {
          "id": "nier.audio"
        },
        {
          "id": "nier.monitor"
        },
        {
          "id": "nier.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": []
}
