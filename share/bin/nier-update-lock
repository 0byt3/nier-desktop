#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Run a command while holding the Nier update lock
# nier:args=<held|run> [command] [args...]
# nier:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/nier-update.lock"

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${NIER_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$NIER_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$NIER_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$NIER_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: nier-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {NIER_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$NIER_UPDATE_LOCK_FD"; then
      echo "An Nier update is already running."
      exit 1
    fi

    export NIER_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: nier-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac
