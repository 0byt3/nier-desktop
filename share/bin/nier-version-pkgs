#!/bin/bash

# Credit: Adapted from Omarchy
# nier:summary=Print the latest installed RPM transaction time
set -euo pipefail
# RPM install times work for both DNF and direct RPM transactions, without root.
latest=$(rpm -qa --qf '%{INSTALLTIME}\n' | sort -n | tail -1)
if [[ ! $latest =~ ^[0-9]+$ ]]; then
  echo 'No installed RPM transaction timestamp is available.' >&2
  exit 1
fi
date -d "@$latest" '+%A, %B %d %Y at %H:%M'
