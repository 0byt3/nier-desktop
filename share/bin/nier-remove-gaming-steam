#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Remove Steam and all of its game libraries, configs, and caches.
# nier:requires-sudo=true

set -e

nier-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
