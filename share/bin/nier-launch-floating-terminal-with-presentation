#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Launch a floating terminal with the Nier presentation wrapper
# nier:args=<command>


cmd="$*"
presentation_script="nier-show-logo; $cmd; if (( \$? != 130 )); then nier-show-done; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.nier.terminal --title=Nier -e bash -c "$presentation_script"
