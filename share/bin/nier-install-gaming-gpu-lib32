#!/bin/bash

# Credit: Adapted from Omarchy
# nier:summary=Install Fedora 32-bit Mesa drivers, plus NVIDIA libraries when the NVIDIA driver is already installed
# nier:group=install
# nier:name=gaming gpu-lib32
# nier:requires-sudo=true
set -euo pipefail
packages=(mesa-vulkan-drivers.i686 mesa-dri-drivers.i686 vulkan-loader.i686)
if rpm -q xorg-x11-drv-nvidia >/dev/null 2>&1; then
  packages+=(xorg-x11-drv-nvidia-libs.i686)
fi
nier-pkg-add "${packages[@]}"
