#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Overwrite all the user Hyprland Lua configs in ~/.config/hypr with the Nier defaults.

nier-refresh-config hypr/.luarc.json
nier-refresh-config hypr/autostart.lua
nier-refresh-config hypr/bindings.lua
nier-refresh-config hypr/input.lua
nier-refresh-config hypr/looknfeel.lua
nier-refresh-config hypr/hyprland.lua
nier-refresh-config hypr/monitors.lua

mkdir -p ~/.local/state/nier/toggles/hypr
cp "$NIER_PATH/default/hypr/toggles/flags.lua" ~/.local/state/nier/toggles/hypr/
