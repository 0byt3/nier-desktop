#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Show which theme is styling the Plymouth boot screen
# nier:examples=nier plymouth current

# nier-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/nier/logo.png

if cmp -s "$NIER_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

nier-plymouth-list | while read -r name; do
  if cmp -s "$(nier-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
