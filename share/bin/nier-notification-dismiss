#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Dismiss a notification by summary substring. Used by the first-run notifications to dismiss them after clicking for action.
# nier:args=<summary>

if (($# == 0)); then
  echo "Usage: nier-notification-dismiss <summary>"
  exit 1
fi

nier-shell -q notifications dismiss "$1"
