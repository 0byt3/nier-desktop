#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Print the active Nier package channel

set -euo pipefail

# Dev is a linked source checkout: NIER_PATH points somewhere other than
# the package-backed install at /usr/local/share/nier. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $NIER_PATH != "/usr/local/share/nier" ]]; then
  echo dev
  exit 0
fi

# nier-dev / nier-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. nier / nier-settings come
# from either the stable or rc mirror, distinguished by nier-version-channel
# (which reports the mirror as its first token).
if pacman -Q nier-dev nier-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q nier nier-settings >/dev/null 2>&1; then
  channel=$(nier-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
