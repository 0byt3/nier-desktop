#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Open HEY webmail and translate mailto links
# nier:args=[url]

url="$1"
web_url="https://app.hey.com"

# Handle mailto: URLs
if [[ $url =~ ^mailto: ]]; then
  email=$(echo "$url" | sed 's/mailto://')
  web_url="https://app.hey.com/messages/new?to=$email"
fi

exec nier-launch-webapp "$web_url"
