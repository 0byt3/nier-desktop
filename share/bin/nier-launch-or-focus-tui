#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Launch a TUI or focus an existing terminal window for it
# nier:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.nier.$(basename "$1")"
fi

LAUNCH_COMMAND="nier-launch-tui $@"

exec nier-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
