#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  nier-brightness-keyboard-mute on
  nier-osd -i microphone-muted -m "Microphone muted"
else
  nier-brightness-keyboard-mute off
  nier-osd -i microphone -m "Microphone on"
fi
