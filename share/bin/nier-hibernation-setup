#!/bin/bash
# Credit: Adapted from Omarchy
# nier:summary=Configure a Btrfs swapfile and Fedora dracut/GRUB resume settings
# nier:requires-sudo=true
# nier:args=[--force] [--no-rebuild]
set -euo pipefail
force=false
args=()
for arg in "$@"; do
  case "$arg" in
    --force) force=true ;;
    --no-rebuild) args+=("$arg") ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done
if ! $force && ! gum confirm 'Allocate RAM-sized disk swap and configure Fedora hibernation?'; then
  exit 0
fi
exec sudo python3 "${NIER_PATH:-/usr/local/share/nier}/lib/nier-hibernation.py" setup "${args[@]}"
