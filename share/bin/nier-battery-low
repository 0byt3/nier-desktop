#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Send the low battery warning notification and run battery-low hooks.
# nier:args=<percentage>
# nier:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: nier-battery-low <percentage>" >&2
  exit 1
fi

level=$1

nier-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
nier-hook battery-low "$level"
