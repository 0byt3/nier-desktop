#!/bin/bash
# Credit: Adapted from Omarchy
# nier:summary=Build and install a development RPM from a local Nier Desktop checkout
# nier:group=dev
# nier:args=[spec-file] [path-to-checkout]
# nier:requires-sudo=true
set -euo pipefail
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<'USAGE'
Usage: nier dev pkg-test [spec-file] [path-to-checkout]
Defaults to the active Nier checkout and its sibling
nier-copr/packages/nier-desktop/nier-desktop.spec (or $NIER_RPM_SPEC).
Requires rpm-build and the spec's BuildRequires to be installed on Fedora.
Builds unprivileged, then installs the resulting RPM through DNF.
Development RPMs use release 999.dev.TIMESTAMP.gCOMMIT so installed builds
can be replaced. Use dnf distro-sync nier-desktop to return to repository builds.
USAGE
  exit 0
fi
(( $# <= 2 )) || { echo 'Too many arguments; see --help.' >&2; exit 2; }
checkout=$(realpath "${2:-${NIER_PATH:-/usr/local/share/nier}/..}")
spec=${1:-${NIER_RPM_SPEC:-$checkout/../nier-copr/packages/nier-desktop/nier-desktop.spec}}
[[ -f $spec && -f $checkout/share/version && -f $checkout/bin/nier ]] || {
  echo 'Provide the nier-desktop RPM spec and source checkout; see --help.' >&2; exit 1;
}
command -v rpmbuild >/dev/null || { echo 'Install Fedora rpm-build first.' >&2; exit 127; }
build=$(mktemp -d -t nier-rpm-test.XXXXXX)
trap 'rm -rf "$build"' EXIT
mkdir -p "$build"/{SOURCES,SPECS,BUILD,RPMS,SRPMS}
sha=$(git -C "$checkout" rev-parse HEAD)
release="999.dev.$(date -u +%Y%m%d%H%M%S).g${sha:0:7}"
python3 - "$spec" "$build/SPECS/nier-desktop.spec" "$sha" "$release" <<'PY'
from pathlib import Path
import re
import sys
source, target, commit, release = sys.argv[1:]
text = Path(source).read_text()
if not re.search(r'^Name:\s+nier-desktop\s*$', text, re.M):
    raise SystemExit('This helper only builds the Nier Desktop RPM.')
text = re.sub(r'^%global commit .*$', '%global commit ' + commit, text, flags=re.M)
text = re.sub(r'^Release:.*$', 'Release: ' + release + '%{?dist}', text, flags=re.M)
text = re.sub(r'^Source0:.*$', 'Source0: nier-desktop-dev.tar.gz', text, flags=re.M)
Path(target).write_text(text)
PY
tar --exclude=.git --exclude=__pycache__ --exclude=.state --exclude=dist \
  --transform="s,^\\.,nier-desktop-$sha," \
  -czf "$build/SOURCES/nier-desktop-dev.tar.gz" -C "$checkout" .
rpmbuild --define "_topdir $build" -bb "$build/SPECS/nier-desktop.spec"
mapfile -d '' -t packages < <(find "$build/RPMS" -name '*.rpm' -type f -print0)
(( ${#packages[@]} )) || { echo 'No RPM was built.' >&2; exit 1; }
sudo dnf install -y -- "${packages[@]}"
