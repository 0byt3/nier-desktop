#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Refresh the SDDM theme from default
# nier:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves an untrusted source or
# follows a destination symlink while restoring the packaged SDDM theme.
exec "$NIER_PATH/bin/nier-plymouth-set" --refresh-sddm-default
