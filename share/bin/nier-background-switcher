#!/bin/bash

# Credit: Adapted from Omarchy
# nier:summary=Select a background image and print its path
# nier:group=background
# nier:name=select
# nier:aliases=nier background

set -euo pipefail

picked=$(nier-file-select \
  --title "Select Background Image" \
  --extensions "jpg jpeg png gif bmp webp") || exit 0

if [[ -n ${picked} ]]; then
  printf '%s\n' "${picked}"
fi
