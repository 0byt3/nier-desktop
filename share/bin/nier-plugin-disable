#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Disable a shell plugin
# nier:group=plugin
# nier:args=<id>

set -euo pipefail

fail() {
  echo "nier-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: nier plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(nier-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: nier-shell shell rescanPlugins"

echo "Disabled $id"
