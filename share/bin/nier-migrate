#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Run pending Nier migrations.
# nier:args=[--pending]

set -euo pipefail

mode="run"

usage() {
  echo "Usage: nier-migrate [--pending]"
}

while (($#)); do
  case "$1" in
    --pending|--check)
      mode="pending"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

NIER_PATH="${NIER_PATH:-/usr/local/share/nier}"
STATE_DIR="${NIER_MIGRATION_STATE:-$HOME/.local/state/nier/migrations}"
MIGRATIONS_DIR="$NIER_PATH/migrations"

migration_entries() {
  [[ -d $MIGRATIONS_DIR ]] || return 0

  local file filename

  for file in "$MIGRATIONS_DIR"/*.sh; do
    [[ -f $file ]] || continue
    filename=$(basename "$file")
    printf '%s\t%s\t%s\n' "$filename" "$file" "$STATE_DIR/$filename"
  done
}

pending_migrations() {
  local name file marker

  while IFS=$'\t' read -r name file marker; do
    [[ -n $name ]] || continue
    if [[ ! -f $marker ]]; then
      printf '%s\n' "$name"
    fi
  done < <(migration_entries)
}

if [[ $mode == "pending" ]]; then
  pending_output=$(pending_migrations)
  if [[ -n $pending_output ]]; then
    printf '%s\n' "$pending_output"
    exit 0
  else
    exit 1
  fi
fi

# RPM's lock is a persistent file, not a sentinel. Test the actual write lock
# with a POSIX read lock; never remove it or infer activity from existence.
python3 "$NIER_PATH/lib/nier-rpm-wait.py" || exit 1

mkdir -p "$STATE_DIR"
[[ -d $MIGRATIONS_DIR ]] || exit 0

while IFS=$'\t' read -r name file marker <&3; do
  [[ -n $name ]] || continue

  if [[ ! -f $marker ]]; then
    echo -e "\e[32m\nRunning migration (${name%.sh})\e[0m"
    NIER_PATH="$NIER_PATH" bash -euo pipefail "$file" 3<&-
    mkdir -p "$(dirname "$marker")"
    touch "$marker"
  fi
done 3< <(migration_entries)

# Clear a login-time notification the user left sitting there and then resolved
# by running migrations some other way. The substring matches both the current
# and legacy notification titles.
nier-notification-dismiss "Nier Migrations" >/dev/null 2>&1 || true
