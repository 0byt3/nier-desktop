#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Apply Nier system setup in the installed target
# nier:group=apply
# nier:requires-sudo=true
# nier:examples=nier apply system --install-user dhh --first-install
# nier:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: nier apply system --install-user USER [--first-install|--upgrade]
       nier apply system --defer-provisioning --first-install

Runs root-owned Nier system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
nier-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/nier/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${NIER_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: nier-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export NIER_INSTALL_USER="$install_user"
export NIER_FIRST_INSTALL="$first_install"
export NIER_UPGRADE="$upgrade"
export NIER_PATH="${NIER_PATH:-/usr/local/share/nier}"
export NIER_INSTALL="${NIER_INSTALL:-$NIER_PATH/install}"
export NIER_INSTALL_LOG_FILE="${NIER_INSTALL_LOG_FILE:-/var/log/nier-install.log}"
export PATH="$NIER_PATH/bin:$PATH"

source "$NIER_INSTALL/helpers/logging.sh"
start_install_log

source "$NIER_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  nier-apply-hardware --defer-provisioning
else
  nier-apply-hardware --install-user "$install_user"
fi

source "$NIER_INSTALL/login/all.sh"
source "$NIER_INSTALL/post-install/all.sh"

stop_install_log
