#!/bin/bash

# Credit: Adapted from Omarchy
# nier:summary=Review and optionally remove unused Fedora dependency packages
# nier:requires-sudo=true
set -euo pipefail
# Capture the query status: a repository/RPM error must not look like an empty list.
output=$(dnf -q repoquery --installed --unneeded --qf '%{name}.%{arch}\n')
[[ -n $output ]] || exit 0
printf 'Unused dependency packages:\n%s\n' "$output"
if [[ ! -t 0 || ! -t 1 ]]; then
  echo 'Run nier update orphan-pkgs in a terminal to review the removal transaction.'
  exit 0
fi
if gum confirm --default=false 'Review removal of unused dependencies in DNF?'; then
  # Let DNF resolve again and show its final transaction; do not auto-confirm removal.
  sudo dnf autoremove
fi
