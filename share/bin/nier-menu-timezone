#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Select and set the system timezone
# nier:group=menu
# nier:name=timezone

set -e

timezone=$(timedatectl list-timezones | nier-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
nier-shell -q nier.clock refresh
nier-notification-send "Timezone is now set to $timezone"
