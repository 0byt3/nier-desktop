#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Install Xbox Cloud Gaming as a web app and launch it.
# nier:group=install
# nier:name=gaming xbox-cloud

set -e

echo "Installing Xbox Cloud Gaming..."
nier-webapp-install "Xbox Cloud Gaming" "https://www.xbox.com/en-US/play" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/xbox.png"

setsid nier-launch-webapp "https://www.xbox.com/en-US/play" >/dev/null 2>&1 &
