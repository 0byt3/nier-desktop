#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Nier default and rebuild it.
# nier:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$NIER_PATH/bin/nier-plymouth-set" --refresh-default
