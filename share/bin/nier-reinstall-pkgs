#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Reinstall all default Nier packages from the stable channel
# nier:requires-sudo=true

set -e

# Reinstall all default Nier packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
nier-refresh-pacman

# Downgrade any packages to the stable setup
sudo env NIER_UPDATE_PACMAN=1 pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$NIER_PATH/install/nier-base.packages" | grep -v '^$')
sudo env NIER_UPDATE_PACMAN=1 pacman -Syu --noconfirm --needed "${packages[@]}"
