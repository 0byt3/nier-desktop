#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Apply Nier hardware-specific packages and system configuration
# nier:group=apply
# nier:requires-sudo=true
# nier:examples=nier apply hardware --install-user erolleman
# nier:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: nier apply hardware --install-user USER

Runs idempotent hardware detection/setup for the installed machine. This is
called by nier-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

USAGE
}

install_user="${NIER_INSTALL_USER:-}"
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      echo 'Deferred ISO provisioning is unsupported; use nier apply on an existing Fedora installation.' >&2
      exit 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: nier-apply-hardware must run as root" >&2
  exit 1
fi

if [[ -z $install_user || $install_user == "root" ]]; then
  echo "Error: --install-user must name the target non-root user" >&2
  exit 1
fi

if ! getent passwd "$install_user" >/dev/null; then
  echo "Error: user '$install_user' does not exist" >&2
  exit 1
fi

export NIER_INSTALL_USER="$install_user"
export NIER_PATH="${NIER_PATH:-/usr/local/share/nier}"
export NIER_INSTALL="${NIER_INSTALL:-$NIER_PATH/install}"
export NIER_INSTALL_LOG_FILE="${NIER_INSTALL_LOG_FILE:-/var/log/nier-install.log}"
export PATH="$NIER_PATH/bin:$PATH"

source "$NIER_INSTALL/helpers/logging.sh"
source "$NIER_INSTALL/hardware/all.sh"

# Rebuild only when hardware setup supplied Nier dracut driver configuration.
if compgen -G '/etc/dracut.conf.d/nier-*.conf' >/dev/null; then
  dracut --force --regenerate-all
fi
