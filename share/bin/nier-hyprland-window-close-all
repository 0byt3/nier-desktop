#!/bin/bash

# Credit: Adapted from Omarchy
# nier:summary=Close all open windows

export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "${XDG_RUNTIME_DIR:-/run/user/${UID}}/hypr" 2>/dev/null | head -n1)}"

hyprctl clients -j 2>/dev/null |
  jq -r ".[].address" |
  while read -r addr; do
    [[ -n ${addr} ]] || continue
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:${addr}\" })" >/dev/null 2>&1 ||
      hyprctl dispatch closewindow "address:${addr}" >/dev/null 2>&1 || true
  done

hyprctl dispatch 'hl.dsp.focus({ workspace = "1" })' >/dev/null 2>&1 ||
  hyprctl dispatch workspace 1 >/dev/null 2>&1 || true
