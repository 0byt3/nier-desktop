#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=List available themes
# nier:examples=nier theme list | nier theme set "Tokyo Night"

{
  find ~/.config/nier/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$NIER_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
