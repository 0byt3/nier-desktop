#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# nier:group=remove
# nier:name=gaming xbox-controllers
# nier:requires-sudo=true

set -e

nier-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
