#!/bin/bash
# Credit: Adapted from Omarchy
# nier:summary=Remove only Nier-owned hibernation swap and Fedora resume settings
# nier:requires-sudo=true
set -euo pipefail
if gum confirm 'Remove the swapfile and resume settings created by Nier?'; then
  exec sudo python3 "${NIER_PATH:-/usr/local/share/nier}/lib/nier-hibernation.py" remove
fi
