#!/bin/bash

# Credit: Adapted from Omarchy
# nier:summary=Update Fedora repository signing-key packages
# nier:requires-sudo=true
set -euo pipefail
# COPR/vendor keys remain managed by their signed repository configuration and DNF.
# Never import or locally trust arbitrary keys on behalf of the user.
exec sudo dnf upgrade --refresh -y fedora-gpg-keys fedora-repos
