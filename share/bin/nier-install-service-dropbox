#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Install and start the Dropbox service. Must then be authenticated via the web.

echo "Installing all dependencies..."
nier-pkg-add dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo "Adding Dropbox to the bar..."
nier-plugin-enable nier.dropbox

echo "Starting Dropbox..."
uwsm-app -- dropbox-cli start &>/dev/null &
echo "See Dropbox icon behind  hover tray in top right and right-click for setup."
