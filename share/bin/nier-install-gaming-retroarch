#!/bin/bash

# Credit: Adapted from Omarchy
# nier:summary=Install RetroArch through Flatpak with a Games folder for ROMs and BIOS files
set -euo pipefail
nier-flatpak-app install org.libretro.RetroArch
mkdir -p "$HOME/Games/bios" "$HOME/Games/roms"
flatpak override --user --filesystem="$HOME/Games" org.libretro.RetroArch
echo 'RetroArch is installed. Select cores in its Online Updater and ROMs/BIOS from ~/Games.'
setsid uwsm-app -- flatpak run org.libretro.RetroArch >/dev/null 2>&1 &
