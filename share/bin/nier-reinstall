#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Reinstall Nier packages and reset default configs
# nier:requires-sudo=true

set -e

echo -e "This will reinstall all default Nier packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  nier-reinstall-pkgs
  nier-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && nier-system-reboot
fi
