#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Update the active Nier dev checkout

set -euo pipefail

[[ $NIER_PATH != "/usr/local/share/nier" ]] || exit 0

if ! git -C "$NIER_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: NIER_PATH is not a git checkout: $NIER_PATH" >&2
  exit 1
fi

upstream=$(git -C "$NIER_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Nier dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Nier dev checkout\e[0m"
git -C "$NIER_PATH" pull --ff-only
