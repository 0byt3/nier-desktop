#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Launch or focus on a given web app identified by the window-pattern.
# nier:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: nier-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="nier-launch-webapp $@"

exec nier-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
