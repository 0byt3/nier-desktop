#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Remove Dropbox and its bar plugin.
# nier:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
nier-plugin-disable nier.dropbox
nier-pkg-drop dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo ""
echo "Dropbox has been removed."
