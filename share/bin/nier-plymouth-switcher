#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Open the Plymouth unlock screen switcher

preview_dir="${XDG_CACHE_HOME:-$HOME/.cache}/nier/unlock-selector/previews"

rm -rf "$preview_dir"
mkdir -p "$preview_dir"

ln -s "$NIER_PATH/default/plymouth/preview-unlock.png" "$preview_dir/default.png"

nier-plymouth-list | while read -r name; do
  ln -s "$(nier-theme-dir "$name")/preview-unlock.png" "$preview_dir/$name.png" 2>/dev/null
done

current=$(nier-plymouth-current)
selected=""
[[ -n $current && -e $preview_dir/$current.png ]] && selected="$preview_dir/$current.png"

exec nier-menu-images --print-name --show-labels --selected "$selected" "$preview_dir"
