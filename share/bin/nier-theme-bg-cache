#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Cache background switcher thumbnails for the current theme

theme_name=$(cat "$HOME/.local/state/nier/current/theme.name" 2>/dev/null)

nier-menu-images \
  --cache-only \
  "$HOME/.local/state/nier/current/theme/backgrounds" \
  "$HOME/.config/nier/backgrounds/$theme_name"
