#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Install the ONCE service, enable its background service, and launch the TUI.
# nier:requires-sudo=true

echo "Installing ONCE..."
nier-pkg-add once-bin

echo "Enabling ONCE background service..."
sudo systemctl enable --now once-background.service

echo -e "\nLaunching ONCE..."
once
