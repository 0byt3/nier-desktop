#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Finalize Nier user setup (runtime tweaks /etc/skel can't do)
# nier:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: nier finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and nier apply
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/nier/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run nier-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/nier"
mkdir -p "$state_dir"

if nier-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete (rerun with --force to refresh)."
  exit 0
fi

export NIER_PATH="${NIER_PATH:-/usr/local/share/nier}"
export NIER_INSTALL="${NIER_INSTALL:-$NIER_PATH/install}"
export NIER_SETUP_CONTEXT="${NIER_SETUP_CONTEXT:-runtime}"
export PATH="$NIER_PATH/bin:$PATH"

if (( first_install )) && [[ $NIER_SETUP_CONTEXT == "runtime" ]]; then
  # First-install finalization records initial defaults without running migrations.
  export NIER_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${NIER_INSTALL_LOG_FILE:-} && -f $NIER_INSTALL/helpers/logging.sh ]]; then
  source "$NIER_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot live in /etc/skel because NIER_PATH may
# point at a dev checkout (nier dev link) where the target differs.
# Loops every skill directory, so shipping a new one needs no edit here.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills
for skill in "$NIER_PATH"/default/agents/skills/*/; do
  skill=${skill%/}
  name=${skill##*/}
  ln -sfn "$skill" ~/.agents/skills/"$name"
  ln -sfn "$skill" ~/.claude/skills/"$name"
  ln -sfn "$skill" ~/.codex/skills/"$name"
  ln -sfn "$skill" ~/.pi/agent/skills/"$name"

done

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$NIER_INSTALL/user/all.sh"

nier-install-applications
env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser chromium.desktop 2>/dev/null || true

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$NIER_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

nier-done mark finalize-user
echo "User finalization complete."
