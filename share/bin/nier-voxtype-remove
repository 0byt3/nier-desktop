#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Remove Voxtype dictation and its configuration
# nier:requires-sudo=true

set -e

# Remove voxtype and its configurations.

if nier-cmd-present voxtype; then
  echo "Uninstall Voxtype to remove dictation."

  # Remove services
  systemctl --user disable --now voxtype.service 2>/dev/null || true
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/voxtype.service.d/20-nier-backend.conf"
  systemctl --user daemon-reload

  # Remove packages and configs
  nier-pkg-drop voxtype
  rm -rf ~/.config/voxtype
  rm -rf ~/.local/share/voxtype
  hyprctl reload >/dev/null
else
  echo "Voxtype was not installed."
fi
