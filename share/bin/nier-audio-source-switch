#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Cycle to the next media source and transfer playback when the current source is playing
# nier:args=[next|previous]
# nier:examples=nier audio source switch | nier-audio-source-switch previous

direction="${1:-next}"

case "$direction" in
  next)
    nier-shell media sourceSwitch
    ;;
  previous)
    nier-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: nier-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
