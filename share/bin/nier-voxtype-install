#!/bin/bash

# Credit: Adapted from Omarchy

# nier:summary=Install and configure Voxtype dictation
# nier:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  nier-pkg-add wtype voxtype vulkan-tools

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  if [[ ! -e ~/.config/voxtype/config.toml ]]; then
    cp "$NIER_PATH/default/voxtype/config.toml" ~/.config/voxtype/
  fi

  # Verify inference before selecting a backend; never replace the RPM's launcher.
  python3 "$NIER_PATH/lib/nier-voxtype-backend.py"
  voxtype setup systemd
  # setup systemd only starts an existing service; apply the new backend on reruns.
  systemctl --user restart voxtype.service

  hyprctl reload >/dev/null
  nier-restart-shell
  nier-notification-send -g  "Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi
