{
  // Credit: Adapted from Omarchy
  // Nier menu definition.

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"nier-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.lock": {"icon":"","label":"Lock","action":"nier-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! nier-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"nier-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"nier-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"nier-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"nier-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"nier-menu-keybindings"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"nier-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"nier-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"nier-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"nier-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"nier-menu-herdr-keybindings"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"nier-menu-emoji"},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"nier-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"nier-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"nier-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"nier-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"nier-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"nier-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"nier-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"nier-hw-webcam","action":"nier-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"nier-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"nier-hw-laptop","action":"nier-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"nier-hw-laptop","action":"nier-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"nier-hw-hybrid-gpu","action":"nier-launch-floating-terminal-with-presentation nier-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"nier-hw-touchpad","action":"nier-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"nier-hw-dell-xps-haptic-touchpad && nier-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"nier-hw-dell-xps-haptic-touchpad && nier-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"nier-hw-dell-xps-haptic-touchpad && nier-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"nier-hw-touchscreen","action":"nier-toggle-touchscreen"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"nier-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"nier-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"nier-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"nier-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"nier-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"nier-toggle-crash-capture"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"nier-toggle-nightlight"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"nier-hyprland-window-gaps-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"nier-shell shell summon nier.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"nier-shell shell summon nier.disk-speedtest"},

  // Style
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(nier-theme-bg-switcher); [[ -n $background ]] && nier-theme-bg-set \"$background\""},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"nier-bar transparent toggle"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"nier-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"nier-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"nier-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"nier-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"nier-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"nier-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"nier-branding-about reset"},

  // Setup
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"nier-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"nier-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(nier-network-status) == wifi* ]]","action":"nier-shell shell summon nier.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.codex": {"icon":"","iconFont":"omarchy","label":"Codex","checked":"[[ \"$(nier-default-agent)\" == \"codex\" ]]","action":"nier-default-agent codex"},
  "setup.default.agent.cursor-agent": {"icon":"","iconFont":"omarchy","label":"Cursor CLI","checked":"[[ \"$(nier-default-agent)\" == \"cursor-agent\" ]]","action":"nier-default-agent cursor-agent"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"nier-hw-fingerprint","action":"nier-launch-floating-terminal-with-presentation nier-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"nier-launch-floating-terminal-with-presentation nier-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"nier-launch-floating-terminal-with-presentation nier-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"nier-launch-floating-terminal-with-presentation nier-sudo-passwordless"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"nier-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"nier-launch-config-editor ~/.config/hypr/hyprsunset.conf && nier-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"nier-launch-config-editor ~/.XCompose && nier-restart-xcompose"},

  // Install
  "install.package": {"icon":"󰉉","label":"Package","aliases":["pkg","dnf","flatpak","mise"],"action":"xdg-terminal-exec --app-id=org.nier.terminal -e nier-pkg-install"},
  "install.webapp": {"icon":"","label":"Web App","aliases":["webapp"],"action":"nier-launch-floating-terminal-with-presentation nier-webapp-install"},

  // Remove
  "remove.package": {"icon":"󰭌","label":"Package","action":"xdg-terminal-exec --app-id=org.nier.terminal -e nier-pkg-remove"},
  "remove.webapp": {"icon":"","label":"Web App","when":"grep -qE '^Exec=.*(nier-launch-webapp|nier-webapp-handler)' $HOME/.local/share/applications/*.desktop","action":"nier-webapp-remove"},

  // Update
  "update.fedora": {"icon":"","label":"Fedora","aliases":["nier"],"action":"nier-launch-floating-terminal-with-presentation nier-update"},
  "update.process": {"icon":"","label":"Process","title":"Restart"},
  "update.hardware": {"icon":"󰇅","label":"Hardware","title":"Restart"},
  "update.firmware": {"icon":"","label":"Firmware","action":"nier-launch-floating-terminal-with-presentation nier-update-firmware"},
  "update.password": {"icon":"","label":"Password"},
  "update.timezone": {"icon":"","label":"Timezone","action":"nier-menu-timezone"},
  "update.time": {"icon":"","label":"Time","action":"nier-launch-floating-terminal-with-presentation nier-update-time"},
  "update.process.hyprsunset": {"icon":"","label":"Hyprsunset","action":"nier-restart-hyprsunset"},
  "update.process.shell": {"icon":"󰍜","label":"Shell","action":"nier-restart-shell"},
  "update.hardware.audio": {"icon":"","label":"Audio","action":"nier-launch-floating-terminal-with-presentation nier-restart-audio"},
  "update.hardware.wifi": {"icon":"󱚾","label":"Wi-Fi","action":"nier-launch-floating-terminal-with-presentation nier-restart-wifi"},
  "update.hardware.bluetooth": {"icon":"󰂯","label":"Bluetooth","action":"nier-launch-floating-terminal-with-presentation nier-restart-bluetooth"},
  "update.hardware.trackpad": {"icon":"󰟸","label":"Trackpad","action":"nier-launch-floating-terminal-with-presentation nier-restart-trackpad"},
  "update.password.drive": {"icon":"","label":"Drive Encryption","action":"nier-launch-floating-terminal-with-presentation nier-drive-password"},
  "update.password.user": {"icon":"","label":"User","action":"nier-launch-floating-terminal-with-presentation passwd"}
}
