[Unit]
Description=Recover the internal monitor toggle when no external display is connected
Before=graphical-session-pre.target
ConditionPathExists=%h/.local/state/nier/toggles/hypr/internal-monitor-disable.lua

[Service]
Type=oneshot
ExecStart=/usr/local/share/nier/bin/nier-hw-recover-internal-monitor

[Install]
WantedBy=graphical-session-pre.target
