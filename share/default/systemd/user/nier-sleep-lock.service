[Unit]
Description=Lock Nier before suspend
# The monitor calls into the running Nier shell. Wait until UWSM has imported
# NIER_PATH and WAYLAND_DISPLAY, but keep the default target ordering so the
# monitor starts before graphical-session.target is reached.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=NIER_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/local/share/nier/bin/nier-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
